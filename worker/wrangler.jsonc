// The practice wallet's Worker: where it runs, what it may reach, what it is told.
//
// Nothing in this file is secret, and nothing in it names an account. The four
// secrets are listed by name only; their values are set on the deployed Worker
// (the first deploy carries them with: wrangler deploy --secrets-file <a file
// kept outside this repository>).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learnbitcoin-practice",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-14",

  // One door only. A wallet lives on one origin (its keys are kept per origin,
  // and a passkey belongs to one host name), so there is no workers.dev copy
  // and no preview or version URL.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "practice.learnbitcoin.com", "custom_domain": true }],

  // The built app. A path with no file gets index.html, so the app's own
  // router can answer it. The Worker runs for /api/ and /p/ only, and it
  // answers every path there itself (a JSON 404 for the ones it does not
  // know), so it never needs to read a built file: no assets binding.
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*"]
  },

  // Brakes on a flood, counted per reader and per minute at each Cloudflare
  // location. They are sized so that a classroom behind one address is never
  // refused. The faucet's real rules (one payment per address per day, a cap
  // per minute) live in the bots, which see every request.
  //
  // One kind of chain read is counted apart from the others, by the same
  // limiter: a page of an address's older transactions that is asked for by
  // an ID. What that read costs the practice network grows with the length
  // of the address's list. The Worker has each of them counted as 50 (the
  // weight it gives the call) under a second key of the reader's, so one
  // reader gets 120 of them a minute beside the 6,000 other chain reads
  // (src/handler.ts, OLDER_PAGE_COST).
  //
  // namespace_id is a number we pick; it only has to be unique in the account.
  "ratelimits": [
    { "name": "CHAIN_LIMIT", "namespace_id": "2620", "simple": { "limit": 6000, "period": 60 } },
    { "name": "BROADCAST_LIMIT", "namespace_id": "2621", "simple": { "limit": 120, "period": 60 } },
    { "name": "FAUCET_LIMIT", "namespace_id": "2622", "simple": { "limit": 40, "period": 60 } },
    { "name": "POT_LIMIT", "namespace_id": "2623", "simple": { "limit": 60, "period": 60 } },
    { "name": "EVENTS_LIMIT", "namespace_id": "2624", "simple": { "limit": 600, "period": 60 } }
  ],

  // Public settings. Every value is text; the Worker turns the three numbers
  // into numbers for GET /api/config.
  "vars": {
    // The practice network's origin: Esplora under /esplora/, the bots under /bots/.
    "ORIGIN_URL": "https://practice-origin.learnbitcoin.com",
    // The faucet's bot check. An empty site key means the faucet is closed.
    // A site key is public: it is sent to every reader's browser. The secret
    // that goes with it is one of the four secrets below, and is written
    // nowhere here. The widget answers only on the hosts its owner has
    // listed, so a copy of this repository run on another host needs a
    // widget, and a site key, of its own.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGB-u7njXBvccBZE",
    // The host a bot-check token must have been made on.
    "TURNSTILE_HOSTNAME": "practice.learnbitcoin.com",
    "EXPLORER_URL": "https://practice-explorer.learnbitcoin.com",
    "ELECTRUM_HOST": "practice-electrum.learnbitcoin.com",
    "ELECTRUM_PORT": "50002",
    // The site events are counted under. Empty means the app sends none.
    // It has to be spelled as the events service knows the site. For a name
    // it does not know, the service answers each event as it answers one
    // it counted and throws the event away, so the Worker's log shows
    // nothing wrong (src/events.ts). After setting this, send one event
    // from a real browser and look for it on the service's own dashboard.
    //
    // The practice wallet is counted under the main site's name. Each event
    // carries that name and the full address of the screen, so the service
    // keeps the wallet's screens with the main site's and can show them
    // apart by host name. A copy of this repository run by someone else
    // must change this name or empty it: left as it is, that copy's readers
    // would be counted here.
    "PLAUSIBLE_DOMAIN": "learnbitcoin.com",
    // "on" sends an event's value as a property; "off" folds it into the
    // event's name ("Passkey: ok"), for a plan without custom properties.
    "EVENT_PROPS": "off",
    "SITE_URL": "https://www.learnbitcoin.com",
    "SOURCE_URL": "https://github.com/treib-holdings/learnbitcoin-practice",
    // The one host where passkeys are offered.
    "PASSKEY_HOST": "practice.learnbitcoin.com",
    "FAUCET_SATS": "100000",
    "BLOCK_SECONDS": "30"
  },

  // A deploy stops while one of these is not set on the Worker.
  //   TURNSTILE_SECRET_KEY                    the bot check's secret
  //   ACCESS_CLIENT_ID, ACCESS_CLIENT_SECRET  the service token that lets this Worker through to the origin
  //   BOTS_API_TOKEN                          the bearer token the faucet and the pot ask for
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "ACCESS_CLIENT_ID", "ACCESS_CLIENT_SECRET", "BOTS_API_TOKEN"]
  },

  // What Cloudflare keeps about a request.
  //
  // Workers Logs is on (enabled, and logs.enabled), so what the Worker
  // writes itself is kept: a line made of a route name, two status codes, a
  // duration and a fault code. The line names no path, address, transaction
  // ID or reader.
  //
  // Invocation logs are off (logs.invocation_logs; left out, they are on).
  // An invocation log is Cloudflare's own record of each request: the
  // request, the answer and their details. Here the URL of a chain read
  // carries a wallet address or a transaction ID, so those records would
  // list which addresses were looked at, and when. Traces are off by name
  // for the same reason: a trace records the full URL of the request and of
  // every fetch made for it, and "off unless asked for" is only today's
  // default.
  //
  // Query strings are cut from the URLs that logs and traces keep
  // (redact_query_string; left out, they are kept). No path of this Worker
  // takes a query string, so the app never sends one. But a link can pick
  // one up on its way (a tracking tag added by a mail program or another
  // site), and a visitor can type anything after a question mark: an
  // address, a transaction ID, an email address. None of it is any use to
  // the owner, so none of it is kept. This covers what follows the
  // question mark and nothing before it: the path of a chain read still
  // holds its address or transaction ID, which is what the next paragraph
  // is about.
  //
  // That may not be all. Workers Logs can store the Worker's own line
  // together with the request it was written in: a stored line has fields
  // for that ($metadata.url, $metadata.trigger, $workers.event.request),
  // and it is not known here whether invocation_logs empties them. So the
  // Worker does not rely on it. A request for chain data that ends without
  // a fault writes no line at all (src/handler.ts): a line that is never
  // written is stored beside nothing. That is every request under
  // /api/esplora/ but a broadcast: the chain reads, and any other path
  // there, which gets a 404. Those are all the requests the app sends the
  // Worker whose URL holds an address or a transaction ID, and one that
  // ends without a fault has nothing to tell the owner. One that ends in a
  // fault still writes its line: something is broken then, and the owner
  // has to see it.
  //
  // After the first deploy, look: ask the deployed Worker for /api/config,
  // open the line that request wrote as Workers Logs stored it, and read
  // every field beside the Worker's own five. Does it carry the request's
  // URL? Does it carry the reader's IP address, as a field or as a header
  // of the request? If neither, nothing more is needed. If the URL is
  // there, then a line written for a chain read that ended in a fault
  // keeps an address or a transaction ID for as long as lines are kept,
  // and so does the line for an unknown path outside /api/esplora/ into
  // which a visitor typed one. If the IP address is there, every line says
  // who asked. Either has to change, or be said on the app's About screen.
  // Then ask once for /api/nothing?probe=1 and open that line too: a URL
  // stored beside it should end before the question mark.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
