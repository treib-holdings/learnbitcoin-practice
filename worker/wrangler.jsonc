// The practice wallet's Worker: where it runs, what it may reach, what it is told.
//
// Nothing in this file is secret, and nothing in it names an account. The four
// secrets are listed by name only; their values are set on the deployed Worker
// (the first deploy carries them with: wrangler deploy --secrets-file <a file
// kept outside this repository>).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learnbitcoin-practice",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-14",

  // One door only. A wallet lives on one origin (its keys are kept per origin,
  // and a passkey belongs to one host name), so there is no workers.dev copy
  // and no preview or version URL.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "practice.learnbitcoin.com", "custom_domain": true }],

  // The built app. A path with no file gets index.html, so the app's own
  // router can answer it. The Worker runs for /api/ and /p/ only, and it
  // answers every path there itself (a JSON 404 for the ones it does not
  // know), so it never needs to read a built file: no assets binding.
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*"]
  },

  // Brakes on a flood, counted per reader and per minute at each Cloudflare
  // location. They are sized so that a classroom behind one address is never
  // refused. The faucet's real rules (one payment per address per day, a cap
  // per minute) live in the bots, which see every request.
  //
  // One kind of chain read is counted apart from the others, by the same
  // limiter: a page of an address's older transactions that is asked for by
  // an ID. What that read costs the practice network grows with the length
  // of the address's list. The Worker has each of them counted as 50 (the
  // weight it gives the call) under a second key of the reader's, so one
  // reader gets 120 of them a minute beside the 6,000 other chain reads
  // (src/handler.ts, OLDER_PAGE_COST).
  //
  // The pot's limiter counts two things apart in the same way: asking for
  // the pot's address ("Pass it on"), and looking at the pot's counts, which
  // anybody can do with a plain GET while the counts are switched on
  // (POT_COUNTS, further down). The looks are counted under a second key of
  // the reader's, so they can never use up what "Pass it on" needs
  // (src/handler.ts, POT_STATS): 60 a minute of each for one reader.
  //
  // Every limiter here is a brake on one reader. None of them is a cap for
  // all readers together. And what a look at the pot's counts costs the
  // practice network is not fixed: it can grow with the number of coins
  // that wait in the pot, and anybody can add coins to the pot. So the
  // limiter is not what keeps the looks of many readers away from the
  // practice network. Two other things are there for that.
  //
  // The first is in the Worker (src/pot-stats.ts). Each isolate that
  // Cloudflare runs the Worker in asks the network for the counts once,
  // keeps the answer in its memory, and gives it to every reader it serves
  // for 15 seconds. An isolate has one question out at a time, whoever
  // looks and however often. While the network answers, that comes to four
  // questions a minute. While it does not, it comes to one every 5 seconds
  // at the most: after a question that failed, the isolate asks no other
  // for 5 seconds. All of that is a bound for one isolate. It is not one
  // answer for a whole Cloudflare location, and not one for the whole
  // network, and Cloudflare may run many isolates. No setting in this file
  // changes the 15 or the 5 seconds, or switches the keeping off. A look
  // is still counted at the limiter first, and a reader over the limit is
  // refused.
  //
  // The second is the setting POT_COUNTS, which switches the counts off
  // altogether, and off is how this file ships. The note at the setting
  // says why, and when it may be switched on.
  //
  // namespace_id is a number we pick; it only has to be unique in the account.
  "ratelimits": [
    { "name": "CHAIN_LIMIT", "namespace_id": "2620", "simple": { "limit": 6000, "period": 60 } },
    { "name": "BROADCAST_LIMIT", "namespace_id": "2621", "simple": { "limit": 120, "period": 60 } },
    { "name": "FAUCET_LIMIT", "namespace_id": "2622", "simple": { "limit": 40, "period": 60 } },
    { "name": "POT_LIMIT", "namespace_id": "2623", "simple": { "limit": 60, "period": 60 } },
    { "name": "EVENTS_LIMIT", "namespace_id": "2624", "simple": { "limit": 600, "period": 60 } }
  ],

  // Public settings. Every value is text; the Worker turns the three numbers
  // into numbers for GET /api/config.
  "vars": {
    // The practice network's origin: Esplora under /esplora/, the bots under /bots/.
    "ORIGIN_URL": "https://practice-origin.learnbitcoin.com",
    // The faucet's bot check. An empty site key means the faucet is closed.
    // A site key is public: it is sent to every reader's browser. The secret
    // that goes with it is one of the four secrets below, and is written
    // nowhere here. The widget answers only on the hosts its owner has
    // listed, so a copy of this repository run on another host needs a
    // widget, and a site key, of its own.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGB-u7njXBvccBZE",
    // The host a bot-check token must have been made on.
    "TURNSTILE_HOSTNAME": "practice.learnbitcoin.com",
    "EXPLORER_URL": "https://practice-explorer.learnbitcoin.com",
    "ELECTRUM_HOST": "practice-electrum.learnbitcoin.com",
    "ELECTRUM_PORT": "50002",
    // The site events are counted under. Empty means the app sends none.
    // It has to be spelled as the events service knows the site. For a name
    // it does not know, the service answers each event as it answers one
    // it counted and throws the event away, so the Worker's log shows
    // nothing wrong (src/events.ts). After setting this, send one event
    // from a real browser and look for it on the service's own dashboard.
    //
    // The practice wallet is counted under the main site's name. Each event
    // carries that name and the full address of the screen, so the service
    // keeps the wallet's screens with the main site's and can show them
    // apart by host name. A copy of this repository run by someone else
    // must change this name or empty it: left as it is, that copy's readers
    // would be counted here.
    "PLAUSIBLE_DOMAIN": "learnbitcoin.com",
    // "on" sends an event's value as a property; "off" folds it into the
    // event's name ("Passkey: ok"), for a plan without custom properties.
    "EVENT_PROPS": "off",
    "SITE_URL": "https://www.learnbitcoin.com",
    "SOURCE_URL": "https://github.com/treib-holdings/learnbitcoin-practice",
    // The one host where passkeys are offered.
    "PASSKEY_HOST": "practice.learnbitcoin.com",
    "FAUCET_SATS": "100000",
    "BLOCK_SECONDS": "30",
    // The pot's counts: the answer to GET /api/pot/stats, and the line
    // under a done "Pass it on" that shows one of them. "off", as it
    // ships, or "on". Only the exact word "on" switches them on. Any other
    // value leaves them off, and so does a setting that is missing.
    //
    // While it is off, the Worker does not know that path. It answers a
    // request for it as it answers any path it does not know: the same
    // 404, the same headers, the same line in its log. It counts nothing
    // at the limiter and asks the practice network nothing. GET
    // /api/config tells the app that the counts cannot be had, and the app
    // does not ask for them: the line is left out, and no request for it
    // leaves the page. No request can switch it on. So while it is off,
    // nothing on the public site can make the practice network read the
    // pot's counts.
    //
    // It ships off because a look at the counts can cost the practice
    // network a reading of every coin that waits in the pot, and what the
    // Worker does about that is a bound for one isolate only (the note
    // above the limiters).
    //
    // It may be switched on once the bots that run on the practice
    // network's server keep their own reading of the counts, so that a
    // look costs the node next to nothing however many isolates ask. That
    // work is in bots/ of this repository and is not finished, and a
    // change there takes effect on the server only when its bots have been
    // built and started again. Until it is live there, leave this off.
    //
    // A sentence of the app's About page changes with this setting. Under
    // "What our server sees" the page lists the requests for which the
    // Worker writes a line. While this is off the page never asks for the
    // pot's counts, and the list does not name them. Switched on, the page
    // asks, and the list must name "the pot's totals" (serverLog in
    // app/src/strings/about.ts, in both languages). A test of the app
    // reads this setting and fails until the sentence says so.
    "POT_COUNTS": "off"
  },

  // A deploy stops while one of these is not set on the Worker.
  //   TURNSTILE_SECRET_KEY                    the bot check's secret
  //   ACCESS_CLIENT_ID, ACCESS_CLIENT_SECRET  the service token that lets this Worker through to the origin
  //   BOTS_API_TOKEN                          the bearer token the faucet and the pot ask for
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "ACCESS_CLIENT_ID", "ACCESS_CLIENT_SECRET", "BOTS_API_TOKEN"]
  },

  // What Cloudflare keeps about a request.
  //
  // Workers Logs is on (enabled, and logs.enabled), so what the Worker
  // writes itself is kept: a line made of a route name, two status codes, a
  // duration and a fault code. The line names no path, address, transaction
  // ID or reader.
  //
  // Invocation logs are off (logs.invocation_logs; left out, they are on).
  // An invocation log is Cloudflare's own record of each request: the
  // request, the answer and their details. Here the URL of a chain read
  // carries a wallet address or a transaction ID, so those records would
  // list which addresses were looked at, and when. Traces are off by name
  // for the same reason: a trace records the full URL of the request and of
  // every fetch made for it, and "off unless asked for" is only today's
  // default.
  //
  // Query strings are cut from the URLs that logs and traces keep
  // (redact_query_string; left out, they are kept). No path of this Worker
  // takes a query string, so the app never sends one. But a link can pick
  // one up on its way (a tracking tag added by a mail program or another
  // site), and a visitor can type anything after a question mark: an
  // address, a transaction ID, an email address. None of it is any use to
  // the owner, so none of it is kept. This covers what follows the
  // question mark and nothing before it: the path of a chain read still
  // holds its address or transaction ID, which is what the next paragraph
  // is about. (Whether a stored URL really ends before the question mark
  // is still to look at: see the last paragraph.)
  //
  // That is not all that is kept. Workers Logs stores the Worker's own
  // line together with the request it was written in, and it does so with
  // invocation logs off too. After the first deploy, one line that the
  // deployed Worker wrote was looked at as Workers Logs stored it. Beside
  // the Worker's own fields it held: the request's method, URL and path
  // ($workers.event.request, and again as $metadata.trigger), the time,
  // the Worker's name and version, and IDs of the request (request, ray,
  // trace and span). The rest was about the Worker and the stored line
  // itself: the kind of event, the account, the line's own ID and size.
  // It held no IP address, no header of the request and nothing about
  // where the reader was.
  //
  // That was one line: of a count that went well, with invocation logs
  // off. What a stored line holds with them on has not been looked at
  // here, so the About screen's "no IP address" stands on that setting. A
  // line written for a fault has not been looked at either.
  //
  // So the URL is kept, and the Worker is built for that. A request for
  // chain data that ends without a fault writes no line at all
  // (src/handler.ts): a line that is never written is stored beside
  // nothing. That is every request under /api/esplora/ but a broadcast:
  // the chain reads, and any other path there, which gets a 404. Those are
  // all the requests the app sends the Worker whose URL holds an address
  // or a transaction ID, and one that ends without a fault has nothing to
  // tell the owner. One that ends in a fault still writes its line:
  // something is broken then, and the owner has to see it. The URL beside
  // that line keeps the address or the transaction ID for as long as lines
  // are kept, and so does the URL beside the line for an unknown path
  // outside /api/esplora/ into which a visitor typed one. The app's About
  // screen says the first in so many words, and the second only by saying
  // that the web address is kept.
  //
  // Still to look at: ask once for /api/nothing?probe=1 and open the line
  // it wrote. The URL stored beside it should end before the question mark.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
