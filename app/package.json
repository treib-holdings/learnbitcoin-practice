{
  "name": "@learnbitcoin/practice-app",
  "version": "0.1.0",
  "private": true,
  "description": "The LearnBitcoin practice wallet: a single-page app (Svelte 5, Vite, Tailwind CSS 4).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test test/",
    "gallery": "node ../e2e/src/gallery.ts",
    "gallery:dev": "vite --config dev/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@learnbitcoin/practice-contract": "workspace:*",
    "@learnbitcoin/practice-wallet": "workspace:*",
    "qr": "0.7.2",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
